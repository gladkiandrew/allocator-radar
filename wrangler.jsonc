// Public read-only snapshot of Allocator Radar, served as static assets (no Worker script).
// Build it with `make deploy-public`: export-static -> wall-static -> wrangler deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allocator-radar",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // /how serves how.html; links inside the snapshot are relative *.html paths.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domain on the amagna.co zone (the zone is inferred from the hostname).
  // Wrangler creates the DNS record and certificate on deploy.
  "routes": [
    { "pattern": "allocator.amagna.co", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
