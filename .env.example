# Copy to .env (gitignored). Never commit real values.
#
# LLM backend. Default: claude_code = headless `claude -p` on your Claude subscription.
#   Mac: be logged in to Claude Code (`claude auth status` -> authMethod claude.ai).
#   VPS: run `claude login` (or `claude setup-token` -> CLAUDE_CODE_OAUTH_TOKEN) as the service user.
# RADAR_LLM_BACKEND=claude_code
# RADAR_CLAUDE_BIN=claude
# RADAR_LLM_MODEL=claude-opus-5-5
# RADAR_LLM_EFFORT=medium
#
# Only if you switch to RADAR_LLM_BACKEND=anthropic (API billing):
# ANTHROPIC_API_KEY=
#
# RADAR_LAKE_KEY_FILE=~/.config/allocator-radar/lake.key
# RADAR_AUTH_MODE=basic
# RADAR_AUTH_USER=owner
# RADAR_AUTH_PASSWORD_HASH=   # sha256 hex of the password
